<?xml version="1.0" encoding="UTF-8"?>
<included>

	<!-- every log line also goes to stdout -->
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread]%X{structrScratchMDC}%X{test} %-5level %logger{0} - %msg%n%prefixedEx{structrScratchMDC}</pattern>
		</encoder>
	</appender>

</included>
