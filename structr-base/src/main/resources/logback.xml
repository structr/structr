<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<conversionRule conversionWord="prefixedEx" class="org.structr.logging.PrefixingThrowableConverter" />

	<!--
		%X{test} names the test that wrote a line and is always empty in a running server, so the
		server log is unchanged. It is here to keep the pattern identical to logback-test.xml, which
		all test runs use (structr-base directly, the other modules via its test jar). See
		org.structr.test.common.TestContextListener.
	-->

	<!--
		LOG_ROTATION selects who rotates the server and request logs: "structr" (default) rolls them,
		"external" writes plain files for an outside rotator like logrotate, which the Debian package uses.
	-->
	<include resource="logback-rotation-${LOG_ROTATION:-structr}.xml" />

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread]%X{structrScratchMDC}%X{test} %-5level %logger{0} - %msg%n%prefixedEx{structrScratchMDC}</pattern>
		</encoder>
	</appender>

	<logger name="org.structr" level="INFO"/>
	<logger name="org.apache.commons.beanutils" level="WARN" />

	<root level="INFO">
		<appender-ref ref="STDOUT" />
		<appender-ref ref="SERVERLOG" />
	</root>

	<include file="logback-include.xml" optional="true" />

	<!-- Module specific logging configuration -->
	<logger name="org.apache.kafka" level="WARN" />

	<!-- Jetty Request logging configuration -->
	<logger name="org.eclipse.jetty.server.RequestLog" additivity="false">
		<appender-ref ref="REQUESTLOG" />
	</logger>

</configuration>