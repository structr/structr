<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_CatchSignal"
                  targetNamespace="http://structr.org/bpmn">

  <bpmn:process id="Process_CatchSignal" name="Catch Signal Process" isExecutable="true">

    <bpmn:startEvent id="Start_1" name="Start" />

    <bpmn:intermediateCatchEvent id="Catch_1" name="Wait for signal">
      <bpmn:messageEventDefinition id="msgdef_1" />
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Service_1" name="After signal" />

    <bpmn:endEvent id="End_1" name="Done" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1"   targetRef="Catch_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Catch_1"   targetRef="Service_1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Service_1" targetRef="End_1" />

  </bpmn:process>

</bpmn:definitions>
