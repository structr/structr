<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_ScriptError"
                  targetNamespace="http://structr.org/bpmn">

  <bpmn:process id="Process_ScriptError" name="Script Error Process" isExecutable="true">

    <bpmn:startEvent id="Start_1" name="Start" />

    <!-- A failing script must not abort the process: script task errors are non-fatal. -->
    <bpmn:scriptTask id="Script_1" name="Boom" scriptFormat="structr-javascript">
      <bpmn:script>throw new Error('boom');</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_1" name="Done" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1"  targetRef="Script_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Script_1" targetRef="End_1" />

  </bpmn:process>

</bpmn:definitions>
