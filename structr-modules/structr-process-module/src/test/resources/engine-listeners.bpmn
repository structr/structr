<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:structr="http://structr.org/schema/process/1.0"
                  id="Definitions_Listeners"
                  targetNamespace="http://structr.org/bpmn">

  <bpmn:process id="Process_Listeners" name="Listener Process" isExecutable="true">

    <bpmn:extensionElements>
      <structr:processListener event="started"   method="onProcessStarted"   phase="on" />
      <structr:processListener event="completed" method="onProcessCompleted" phase="on" />
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_1" name="Start" />

    <bpmn:userTask id="Task_1" name="A task">
      <bpmn:extensionElements>
        <structr:taskListener event="created"   method="onTaskCreated"   phase="on" />
        <structr:taskListener event="completed" method="onTaskCompleted" phase="on" />
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:endEvent id="End_1" name="Done" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1"  targetRef="End_1" />

  </bpmn:process>

</bpmn:definitions>
