<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_BugInclusiveAuto"
                  targetNamespace="http://structr.org/bpmn">

  <bpmn:process id="Process_BugInclusiveAuto" name="Inclusive join with automatic branches" isExecutable="true">

    <bpmn:startEvent id="Start_1" name="Start" />

    <bpmn:inclusiveGateway id="Fork_1" name="Fork" />

    <!-- Two AUTOMATIC (pass-through) branches, no wait state, both unconditional. -->
    <bpmn:manualTask id="ManualTask_A" name="Auto A" />
    <bpmn:manualTask id="ManualTask_B" name="Auto B" />

    <bpmn:inclusiveGateway id="Join_1" name="Join" />

    <bpmn:userTask id="Task_After" name="After Join" />

    <bpmn:endEvent id="End_1" name="Done" />

    <bpmn:sequenceFlow id="Flow_start"  sourceRef="Start_1"      targetRef="Fork_1" />
    <bpmn:sequenceFlow id="Flow_fork_a" sourceRef="Fork_1"       targetRef="ManualTask_A" />
    <bpmn:sequenceFlow id="Flow_fork_b" sourceRef="Fork_1"       targetRef="ManualTask_B" />
    <bpmn:sequenceFlow id="Flow_a_join" sourceRef="ManualTask_A" targetRef="Join_1" />
    <bpmn:sequenceFlow id="Flow_b_join" sourceRef="ManualTask_B" targetRef="Join_1" />
    <bpmn:sequenceFlow id="Flow_after"  sourceRef="Join_1"       targetRef="Task_After" />
    <bpmn:sequenceFlow id="Flow_end"    sourceRef="Task_After"   targetRef="End_1" />

  </bpmn:process>

</bpmn:definitions>
