<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:structr="http://structr.org/schema/process/1.0"
                  id="Definitions_HumanTaskCustom"
                  targetNamespace="http://structr.org/bpmn">

  <bpmn:process id="Process_HumanTaskCustom" name="Human Task Process" isExecutable="true">

    <bpmn:startEvent id="Start_1" name="Start" />

    <bpmn:userTask id="Task_Fill" name="Fill form">
      <!-- Ticket 1588: a step writes only the subject fields it declares. This fixture has no vendor
           form, so it names its contract explicitly; without one the step writes no subject fields. -->
      <bpmn:extensionElements>
        <structr:subjectContract formView="custom"/>
      </bpmn:extensionElements>
      <bpmn:humanPerformer id="hp_1">
        <bpmn:resourceAssignmentExpression>
          <bpmn:formalExpression>${initiator}</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:humanPerformer>
    </bpmn:userTask>

    <bpmn:endEvent id="End_1" name="Done" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Fill" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Fill" targetRef="End_1" />

  </bpmn:process>

</bpmn:definitions>
