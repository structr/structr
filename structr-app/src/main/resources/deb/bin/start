#!/bin/bash

. bin/config

PID=$(running_pid)

if [ -n "$PID" ]; then

	echo "ERROR: server already running (PID $PID)."
	echo
	echo "Please stop the running instance before starting a new one."
	echo
	exit 0

fi

if [ ! -e "logs" ]; then

	echo "Creating logs directory..."
	mkdir logs

fi

# Static UI resources are served directly from the application jar (class path); no need to
# unpack them. To customize them locally, create a 'structr' directory in the working directory -
# it takes precedence over the bundled resources (see HttpService).

echo "Starting Structr instance '$DISPLAY_NAME' in the background."
echo "(Takes 30-60 seconds until the server becomes available. Watch log file $LOG_FILE for 'Initialization complete' message.)"

java $RUN_OPTS $JAVA_OPTS $MAIN_CLASS & echo $! >$PID_FILE