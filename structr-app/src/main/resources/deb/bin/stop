#!/bin/bash

. bin/config

# systemd waits TimeoutSec=120 for this script, so give up a little earlier and let it report the failure
MAX_WAIT=110

PID=$(running_pid)

if [ -z "$PID" ]; then

	echo "ERROR: server not running (no running process in $PID_FILE)."
	exit 0
fi

echo "Stopping Structr instance '$DISPLAY_NAME' (PID $PID)..."

kill "$PID"

for (( i = 0; i < MAX_WAIT; i++ )); do

	if ! kill -0 "$PID" 2>/dev/null; then

		rm -f "$PID_FILE"
		echo "Structr instance '$DISPLAY_NAME' stopped"
		exit 0
	fi

	sleep 1
done

echo "ERROR: Structr instance '$DISPLAY_NAME' (PID $PID) is still running after $MAX_WAIT seconds."
exit 1
