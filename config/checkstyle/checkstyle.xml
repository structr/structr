<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Structr house style — MECHANICAL / STRUCTURAL rules only.

  This enforces the parts of the style that are unambiguous and tool-checkable. The
  SEMANTIC blank-line rules (bound guard clauses, grouped assignments, blank-before-return
  — see CODE_STYLE.md) are intentionally NOT here: Checkstyle's
  stock modules cannot express them, and no reformatter can produce them. Those remain a
  review concern (and a small bespoke linter).

  Severity is "warning" so this can be introduced without breaking the build; flip to
  "error" once the tree is clean if you want it gating.
-->
<module name="Checker">

	<property name="charset" value="UTF-8"/>
	<property name="severity" value="warning"/>
	<property name="fileExtensions" value="java"/>

	<!-- NB: the AGPL header is already enforced by com.mycila:license-maven-plugin (see the root
	     pom); no header check here, to avoid duplicate/conflicting enforcement. -->

	<!-- No trailing whitespace. -->
	<module name="RegexpSingleline">
		<property name="format" value="\s+$"/>
		<property name="message" value="Trailing whitespace is not allowed."/>
	</module>

	<!-- Never more than one consecutive blank line. -->
	<module name="RegexpMultiline">
		<property name="format" value="\r?\n[ \t]*\r?\n[ \t]*\r?\n"/>
		<property name="message" value="More than one consecutive blank line is not allowed."/>
	</module>

	<module name="TreeWalker">

		<!-- Every control statement is braced, even a single-statement if/for/while. -->
		<module name="NeedBraces"/>

		<!-- Opening brace at the end of the line (K&R). -->
		<module name="LeftCurly">
			<property name="option" value="eol"/>
		</module>

		<!-- One statement per line. -->
		<module name="OneStatementPerLine"/>
	</module>
</module>
