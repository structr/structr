<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers ReviewNeedReporter as a Maven lifecycle participant. A Plexus component descriptor is
  the most reliable way to expose a component from a core (.mvn/extensions.xml) extension realm;
  the Sisu @Named index is not consistently scanned for these realms.
-->
<component-set>
	<components>
		<component>
			<role>org.apache.maven.AbstractMavenLifecycleParticipant</role>
			<role-hint>structr-review-need</role-hint>
			<implementation>org.structr.build.ReviewNeedReporter</implementation>
		</component>
	</components>
</component-set>
